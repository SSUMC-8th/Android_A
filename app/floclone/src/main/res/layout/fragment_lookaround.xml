<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".LookaroundFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title_lookaroundFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="둘러보기"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <HorizontalScrollView
            android:id="@+id/scv_looks_lookaroundFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tv_title_lookaroundFragment"
            app:layout_constraintStart_toStartOf="@id/tv_title_lookaroundFragment">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_one_lookaroundFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/tab_background_lookaround"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="8dp"
                    android:text="차트"
                    android:layout_marginStart="20dp"
                    android:textColor="@color/tab_textcolor_lookaround"
                    android:clickable="true"
                    android:focusable="true"
                    />

                <TextView
                    android:id="@+id/btn_two_lookaroundFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/tab_background_lookaround"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="8dp"
                    android:text="영상"
                    android:textColor="@color/tab_textcolor_lookaround"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_three_lookaroundFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/tab_background_lookaround"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="8dp"
                    android:text="장르"
                    android:textColor="@color/tab_textcolor_lookaround"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_four_lookaroundFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/tab_background_lookaround"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="8dp"
                    android:text="상황"
                    android:textColor="@color/tab_textcolor_lookaround"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_five_lookaroundFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/tab_background_lookaround"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="8dp"
                    android:text="분위기"
                    android:textColor="@color/tab_textcolor_lookaround"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_six_lookaroundFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/tab_background_lookaround"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="8dp"
                    android:text="오디오"
                    android:textColor="@color/tab_textcolor_lookaround"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>


        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_tabtitle_lookaroundFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="차트"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/scv_looks_lookaroundFragment"
            app:layout_constraintTop_toBottomOf="@id/scv_looks_lookaroundFragment" />

        <ImageView
            android:id="@+id/imv_arraow_lookaroundFramgent"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/arrowforward"
            app:layout_constraintBottom_toBottomOf="@id/tv_tabtitle_lookaroundFragment"
            app:layout_constraintStart_toEndOf="@id/tv_tabtitle_lookaroundFragment"
            app:layout_constraintTop_toTopOf="@id/tv_tabtitle_lookaroundFragment" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ctl_looksong_lookaroundFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginHorizontal="20dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:background="@drawable/fragment_lookchart_lookaroundfragment"
            android:elevation="5dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_tabtitle_lookaroundFragment"
            >

            <TextView
                android:id="@+id/tv_cardText1_lookaroundFragment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:text="FLO 차트"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_cardText2_lookaroundFragment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="19시 기준"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_cardText1_lookaroundFragment"
                app:layout_constraintStart_toEndOf="@id/tv_cardText1_lookaroundFragment"
                app:layout_constraintTop_toTopOf="@id/tv_cardText1_lookaroundFragment" />

            <TextView
                android:id="@+id/tv_cardText3_lookaroundFragment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 24시간 집계"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                app:layout_constraintStart_toStartOf="@id/tv_cardText1_lookaroundFragment"
                app:layout_constraintTop_toBottomOf="@id/tv_cardText1_lookaroundFragment"/>

            <TextView
                android:id="@+id/tv_listenall_lookaroundFragment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:text="전체듣기"
                android:textColor="#000000"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/look_chart_listen_all_iv"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ic_browse_arrow_right"
                app:layout_constraintBottom_toBottomOf="@id/tv_listenall_lookaroundFragment"
                app:layout_constraintEnd_toStartOf="@id/tv_listenall_lookaroundFragment"
                app:layout_constraintTop_toTopOf="@id/tv_listenall_lookaroundFragment" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_rankings_lookaroundFragment"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_cardText3_lookaroundFragment" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ctl_looksong_lookaroundFragment"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>