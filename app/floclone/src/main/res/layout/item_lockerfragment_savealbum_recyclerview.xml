<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv_songImage_savealbum_recycler"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/bowandarrow"
        android:layout_marginVertical="5dp"
        app:shapeAppearanceOverlay="@style/ImageRoundCorner_two"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_songName_savealbum_recycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="앨범 이름"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintStart_toEndOf="@id/imv_songImage_savealbum_recycler"
        app:layout_constraintBottom_toTopOf="@id/tv_artistName_savealbum_recycler"
        />

    <TextView
        android:id="@+id/tv_artistName_savealbum_recycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가수 이름"
        android:textSize="11sp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/imv_songImage_savealbum_recycler"
        app:layout_constraintTop_toTopOf="@id/imv_songImage_savealbum_recycler"
        app:layout_constraintBottom_toBottomOf="@id/imv_songImage_savealbum_recycler"/>

    <TextView
        android:id="@+id/tv_albuminfo_savealbum_recycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2025.05.15 | 정규 | JPOP"
        android:textSize="11sp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toEndOf="@id/imv_songImage_savealbum_recycler"
        app:layout_constraintTop_toBottomOf="@id/tv_artistName_savealbum_recycler"
        />

    <ImageButton
        android:id="@+id/btn_play_savealbum_recycler"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/btn_player_play"
        android:scaleType="centerInside"
        android:layout_marginEnd="10dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toStartOf="@id/btn_delete_savealbum_recycler"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <ImageButton
        android:id="@+id/btn_pause_savealbum_recycler"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/btn_miniplay_pause"
        android:scaleType="centerInside"
        android:layout_marginEnd="10dp"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/btn_delete_savealbum_recycler"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <ImageButton
        android:id="@+id/btn_delete_savealbum_recycler"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/btn_player_more"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>