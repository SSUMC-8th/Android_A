<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#7DC1F6"
    >

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_first_album_default"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageButton
        android:id="@+id/btn_setting_banner"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/btn_main_setting"
        android:scaleType="centerInside"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/btn_ticket_banner"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/btn_main_ticket"
        android:scaleType="centerInside"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toTopOf="@id/btn_setting_banner"
        app:layout_constraintBottom_toBottomOf="@id/btn_setting_banner"
        app:layout_constraintEnd_toStartOf="@id/btn_setting_banner"/>

    <ImageButton
        android:id="@+id/btn_mic_banner"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/btn_main_mike"
        android:scaleType="centerInside"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toTopOf="@id/btn_setting_banner"
        app:layout_constraintBottom_toBottomOf="@id/btn_setting_banner"
        app:layout_constraintEnd_toStartOf="@id/btn_ticket_banner"/>

    <TextView
        android:id="@+id/tv_jaemok_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="달밤의 감성 산책"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="30dp"
        app:layout_constraintTop_toBottomOf="@id/btn_setting_banner"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/btn_play_banner"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@android:color/transparent"
        android:src="@drawable/btn_panel_play_large"
        android:scaleType="centerInside"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_jaemok_banner"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_songinfo_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:text="총 20곡 2020.12.16"
        android:textSize="14dp"
        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="@id/tv_jaemok_banner"
        app:layout_constraintTop_toBottomOf="@id/tv_jaemok_banner"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv_first_banner"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/yone_lostcorner"
        android:layout_marginTop="10dp"
        android:background="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ImageRoundCorner"
        app:layout_constraintTop_toBottomOf="@id/tv_songinfo_banner"
        app:layout_constraintStart_toStartOf="@id/tv_songinfo_banner"
        />

    <TextView
        android:id="@+id/tv_firstsongName_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:text="Lady"
        android:textStyle="bold"
        android:textSize="17dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toTopOf="@id/imv_first_banner"
        app:layout_constraintStart_toEndOf="@id/imv_first_banner"
        />

    <TextView
        android:id="@+id/tv_firstsongArtist_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:text="Kenshi Yonezu"
        android:textSize="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="@id/imv_first_banner"
        app:layout_constraintStart_toEndOf="@id/imv_first_banner"
        />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv_second_banner"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/yone_lostcorner"
        android:layout_marginTop="20dp"
        android:background="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ImageRoundCorner"
        app:layout_constraintTop_toBottomOf="@id/imv_first_banner"
        app:layout_constraintStart_toStartOf="@id/tv_songinfo_banner"
        />

    <TextView
        android:id="@+id/tv_secondsongName_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:text="Lady"
        android:textStyle="bold"
        android:textSize="17dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toTopOf="@id/imv_second_banner"
        app:layout_constraintStart_toEndOf="@id/imv_second_banner"
        />

    <TextView
        android:id="@+id/tv_secondsongArtist_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:text="Kenshi Yonezu"
        android:textSize="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="@id/imv_second_banner"
        app:layout_constraintStart_toEndOf="@id/imv_second_banner"
        />



</androidx.constraintlayout.widget.ConstraintLayout>