<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp">


    <TextView
        android:id="@+id/tv_sunseSong_album_recycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/tv_songName_album_recycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="노래 이름"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/tv_sunseSong_album_recycler"
        app:layout_constraintTop_toTopOf="@id/tv_sunseSong_album_recycler"
        app:layout_constraintBottom_toBottomOf="@id/tv_sunseSong_album_recycler"/>

    <TextView
        android:id="@+id/tv_artistName_album_recycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가수 이름"
        app:layout_constraintTop_toBottomOf="@id/tv_sunseSong_album_recycler"
        app:layout_constraintStart_toStartOf="@id/tv_songName_album_recycler"/>

    <ImageButton
        android:id="@+id/btn_play_album_recycler"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/play"
        android:layout_marginEnd="10dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toStartOf="@id/btn_more_album_recycler"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <ImageButton
        android:id="@+id/btn_more_album_recycler"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/more"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />




</androidx.constraintlayout.widget.ConstraintLayout>