<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/top_banner_vp"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <ImageButton
                android:id="@+id/home_frag_setting_ibtn"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/btn_main_ticket"
                android:src="@drawable/btn_main_setting"
                app:layout_constraintEnd_toEndOf="@+id/top_banner_vp"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/home_frag_ticket_ibtn"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/btn_main_ticket"
                android:scaleType="fitXY"
                android:src="@drawable/btn_main_ticket"
                app:layout_constraintEnd_toStartOf="@+id/home_frag_setting_ibtn"
                app:layout_constraintTop_toTopOf="@+id/home_frag_setting_ibtn" />

            <ImageButton
                android:id="@+id/home_mike_ibtn"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/btn_main_mike"
                android:scaleType="fitXY"
                android:src="@drawable/btn_main_mike"
                app:layout_constraintEnd_toStartOf="@+id/home_frag_ticket_ibtn"
                app:layout_constraintTop_toTopOf="@+id/home_frag_ticket_ibtn" />

            <TextView
                android:id="@+id/home_panel_total_songs_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="20dp"
                android:text="총 16곡 2025.04.02"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:layout_constraintBottom_toTopOf="@+id/home_panel_total_song1_iv"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/home_panel_total_song1_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="20dp"
                android:scaleType="fitXY"
                android:src="@drawable/img_album_exp"
                app:layout_constraintBottom_toTopOf="@+id/home_panel_total_song2_iv"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/home_panel_total_song1_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:text="잠이 안온다"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/home_panel_total_song1_iv"
                app:layout_constraintTop_toTopOf="@+id/home_panel_total_song1_iv" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="젠(zen)"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/home_panel_total_song1_title_tv"
                app:layout_constraintTop_toBottomOf="@+id/home_panel_total_song1_title_tv" />

            <ImageView
                android:id="@+id/home_panel_total_song2_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="30dp"
                android:scaleType="fitXY"
                android:src="@drawable/img_album_exp"
                app:layout_constraintBottom_toBottomOf="@+id/top_banner_vp"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/home_panel_total_song2_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:text="잠이 안온다"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/home_panel_total_song2_iv"
                app:layout_constraintTop_toTopOf="@+id/home_panel_total_song2_iv" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="젠(zen)"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/home_panel_total_song2_title_tv"
                app:layout_constraintTop_toBottomOf="@+id/home_panel_total_song2_title_tv" />

            <TextView
                android:id="@+id/home_today_music_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="오늘 발매 음악"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_banner_vp" />

            <ImageView
                android:id="@+id/home_today_music_title_btn_iv"
                android:layout_width="20dp"
                android:layout_height="18dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitStart"
                android:src="@drawable/btn_main_arrow_more"
                app:layout_constraintBottom_toBottomOf="@id/home_today_music_title_tv"
                app:layout_constraintStart_toEndOf="@id/home_today_music_title_tv"
                app:layout_constraintTop_toTopOf="@id/home_today_music_title_tv" />

            <TextView
                android:id="@+id/home_today_music_total_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:text="종합"
                android:textColor="#3f3fff"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/home_today_music_domestic_tv"
                app:layout_constraintTop_toBottomOf="@+id/top_banner_vp" />

            <TextView
                android:id="@+id/home_today_music_domestic_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:text="국내"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/home_today_music_oversea_tv"
                app:layout_constraintTop_toBottomOf="@id/top_banner_vp" />

            <TextView
                android:id="@+id/home_today_music_oversea_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:text="해외"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top_banner_vp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_today_music_album_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/home_today_music_total_tv"
                tools:listitem="@layout/item_album" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/ad_banner_vp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="@+id/home_today_music_album_rv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/home_today_music_album_rv" />

            <!--            배너에 indicator 필요하면 homefragment에서 기능 추가-->
<!--            <me.relex.circleindicator.CircleIndicator3-->
<!--                        android:id="@+id/circleIndicator"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="32dp"-->
<!--                        app:layout_constraintStart_toStartOf="parent"-->
<!--                        app:layout_constraintEnd_toEndOf="parent"/>-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:text="오디오로 에너지 충전"
                android:textSize="25dp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/ad_banner_vp" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>