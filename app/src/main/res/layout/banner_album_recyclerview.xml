<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/bannerAlbumLists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <ImageView
            android:id="@+id/bannerAlbumImg"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/img_album_drama"
            android:layout_marginStart="15dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bannerAlbumSongName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="제목"
                android:textColor="@color/black"
                android:layout_marginStart="10dp"/>

            <TextView
                android:id="@+id/bannerAlbumSongArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가수"
                android:textColor="@color/black"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <ImageButton
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/btn_miniplay_mvplay"
            android:layout_gravity="center_vertical"
            android:background="@null"
            android:padding="0dp"
            android:scaleType="centerCrop"
            />
        <ImageButton
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/btn_player_more"
            android:layout_gravity="center_vertical"
            android:background="@null"
            android:padding="0dp"
            android:scaleType="centerCrop"
            />

    </LinearLayout>

</androidx.cardview.widget.CardView>